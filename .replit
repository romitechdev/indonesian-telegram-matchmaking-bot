
entrypoint = "main.py"
modules = ["python-3.11"]

[unitTest]
language = "python3"

[deployment]
run = ["python3 main.py"]

[[ports]]
localPort = 8080
externalPort = 80

[nix]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

